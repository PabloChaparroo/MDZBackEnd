# Variables de entorno del backend en producción (perfil por defecto).
# Copiá los nombres al panel de Render. NO pongas valores reales en este archivo.

# --- Base de datos (Neon) ---
DB_HOST=ep-xxxx.us-east-2.aws.neon.tech
DB_PORT=5432
DB_NAME=mdzmuebles
DB_USER=
DB_PASSWORD=
DB_SSLMODE=require
# Opcional (por defecto 5)
# DB_POOL_SIZE=5

# --- Seguridad ---
# Generar con: openssl rand -base64 32   (obligatoria: sin ella la app no arranca)
JWT_SECRET=
# Orígenes del front separados por coma, sin barra final (vacío = ninguno)
CORS_ALLOWED_ORIGINS=https://mdzmuebles.pages.dev,https://*.mdzmuebles.pages.dev
# Clave del admin inicial (esteban@gmail.com). Solo se usa si el admin todavía no existe.
ADMIN_PASSWORD=

# --- Mail ---
# Render gratis bloquea SMTP: en producción se manda por la API de Gmail (HTTPS).
MAIL_PROVIDER=gmail-api
MAIL_FROM=MDZ Muebles <mdzmuebles.web@gmail.com>
# Respaldo: recibe los avisos de consultas si no hay casillas cargadas en Mi Perfil
MAIL_ADMIN=
# Se obtienen con: node scripts/obtener-token-gmail.js (cliente OAuth "App de escritorio" de Google Cloud)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# (MAIL_HOST, MAIL_PORT, MAIL_USERNAME, MAIL_PASSWORD solo si MAIL_PROVIDER=smtp)

# --- Opcionales ---
# PORT lo pone Render solo. JAVA_OPTS pisa los flags de memoria de la imagen.
# JAVA_OPTS=-XX:MaxRAMPercentage=70 -XX:+UseSerialGC
