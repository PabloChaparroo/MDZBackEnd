# Variables de entorno del backend en producción (perfil por defecto).
# Copiá los nombres al panel de Render. NO pongas valores reales en este archivo.

# --- Base de datos (Neon) ---
DB_HOST=ep-xxxx.us-east-2.aws.neon.tech
DB_PORT=5432
DB_NAME=mdzmuebles
DB_USER=
DB_PASSWORD=
DB_SSLMODE=require
# Opcional (por defecto 5)
# DB_POOL_SIZE=5

# --- Seguridad ---
# Generar con: openssl rand -base64 32   (obligatoria: sin ella la app no arranca)
JWT_SECRET=
# Orígenes del front separados por coma, sin barra final (vacío = ninguno)
CORS_ALLOWED_ORIGINS=https://mdzmuebles.pages.dev
# Clave del admin inicial (esteban@gmail.com). Solo se usa si el admin todavía no existe.
ADMIN_PASSWORD=

# --- Mail (SMTP real) ---
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_ADMIN=

# --- Opcionales ---
# PORT lo pone Render solo. JAVA_OPTS pisa los flags de memoria de la imagen.
# JAVA_OPTS=-XX:MaxRAMPercentage=70 -XX:+UseSerialGC
